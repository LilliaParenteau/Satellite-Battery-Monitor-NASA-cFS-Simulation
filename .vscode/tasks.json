{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure cFS",
            "type": "shell",
            "command": "make native_std.prep",
            "options": {
                "cwd": "/home/LilliaP/cFS"
            },
            "problemMatcher": []
        },
        {
            "label": "Build cFS",
            "type": "shell",
            "command": "make native_std.install",
            "options": {
                "cwd": "/home/LilliaP/cFS"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run cFS",
            "type": "shell",
            "command": "./core-cpu1",
            "options": {
                "cwd": "/home/LilliaP/cFS/build-native_std/exe/cpu1"
            },
            "problemMatcher": []
        },
        {
            "label": "Test Battery",
            "type": "shell",
            "command": "g++ -std=c++17 -Wall -Wextra -pedantic tests/battery_test.cpp fsw/src/battery_logic.cpp -o /tmp/battery_test && /tmp/battery_test",
            "windows": {
                "command": "g++ -std=c++17 -Wall -Wextra -pedantic tests/battery_test.cpp fsw/src/battery_logic.cpp -o battery_test.exe; if ($LASTEXITCODE -eq 0) { .\\battery_test.exe }"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Battery Demo",
            "type": "shell",
            "command": "g++ -std=c++17 -Wall -Wextra -pedantic demo/battery_demo.cpp fsw/src/battery_logic.cpp -o /tmp/battery_demo && /tmp/battery_demo",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}