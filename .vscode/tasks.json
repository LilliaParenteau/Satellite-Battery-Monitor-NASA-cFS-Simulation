{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure cFS",
            "type": "shell",
            "command": "make native_std.prep",
            "options": {
                "cwd": "${env:HOME}/cFS"
            },
            "problemMatcher": []
        },
        {
            "label": "Build cFS",
            "type": "shell",
            "command": "make native_std.install",
            "options": {
                "cwd": "${env:HOME}/cFS"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run cFS",
            "type": "shell",
            "command": "printf 'scenario=%s\\n' '${input:batteryScenario}' > cf/scenario.cfg && ./core-cpu1",
            "options": {
                "cwd": "${env:HOME}/cFS/build-native_std/exe/cpu1"
            },
            "problemMatcher": []
        },
        {
            "label": "Run cFS (Config File)",
            "type": "shell",
            "command": "cp \"${workspaceFolder}/config/scenario.cfg\" cf/scenario.cfg && ./core-cpu1",
            "options": {
                "cwd": "${env:HOME}/cFS/build-native_std/exe/cpu1"
            },
            "problemMatcher": []
        },
        {
            "label": "Test Battery",
            "type": "shell",
            "command": "g++ -std=c++17 -Wall -Wextra -pedantic tests/battery_test.cpp fsw/src/battery_logic.cpp -o /tmp/battery_test && /tmp/battery_test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Battery Demo",
            "type": "shell",
            "command": "g++ -std=c++17 -Wall -Wextra -pedantic demo/battery_demo.cpp fsw/src/battery_logic.cpp -o /tmp/battery_demo && /tmp/battery_demo",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "batteryScenario",
            "type": "pickString",
            "description": "Select the battery simulation scenario",
            "options": [
                {
                    "label": "1 - Normal Operation",
                    "value": "1"
                },
                {
                    "label": "2 - Extended Eclipse",
                    "value": "2"
                },
                {
                    "label": "3 - High Power Consumption",
                    "value": "3"
                }
            ],
            "default": "1"
        }
    ]
}